# Acceptance environment template. Do not put real secrets in this file.
SPRING_PROFILES_ACTIVE=acceptance

DB_URL=jdbc:mysql://<acceptance-db-host>:3306/offerlab_acceptance?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=<acceptance_user>
DB_PASSWORD=<required-secret>

# Schema readiness and other operator scripts accept these explicit fields.
# Keep them aligned with DB_URL/DB_USERNAME/DB_PASSWORD above.
OFFERLAB_DB_HOST=<acceptance-db-host>
OFFERLAB_DB_PORT=3306
OFFERLAB_DB_NAME=offerlab_acceptance
OFFERLAB_DB_USER=<acceptance_user>
OFFERLAB_DB_PASSWORD=<required-secret>

REDIS_HOST=<acceptance-redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<required-secret>
REDIS_DATABASE=0

JWT_SECRET=<required-32-plus-byte-random-secret>
JWT_TTL_HOURS=8

# Each running application instance needs a unique worker/datacenter pair.
# Both values must be integers in the range 0..31.
OFFERLAB_SNOWFLAKE_WORKER_ID=<0-31>
OFFERLAB_SNOWFLAKE_DATACENTER_ID=<0-31>

OFFERLAB_WEB_CORS_ALLOWED_ORIGINS=https://<acceptance-frontend-host>
OFFERLAB_ADMIN_LOCAL_OPEN_ENABLED=false
OFFERLAB_ADMIN_UIDS=
# At least one persisted admin role must include OPS before strict readiness is used.

OFFERLAB_KAFKA_ENABLED=false
KAFKA_BROKERS=

ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=

OFFERLAB_REDIS_PUBSUB_ENABLED=false
OFFERLAB_REALTIME_WEBSOCKET_ENABLED=false
OFFERLAB_LOG_LEVEL=INFO
