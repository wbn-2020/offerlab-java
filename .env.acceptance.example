# Acceptance environment template. Do not put real secrets in this file.
SPRING_PROFILES_ACTIVE=acceptance

DB_URL=jdbc:mysql://<acceptance-db-host>:3306/offerlab_acceptance?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=<acceptance_user>
DB_PASSWORD=<required-secret>

REDIS_HOST=<acceptance-redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<required-secret>
REDIS_DATABASE=0

JWT_SECRET=<required-32-plus-byte-random-secret>
JWT_TTL_HOURS=8

OFFERLAB_WEB_CORS_ALLOWED_ORIGINS=https://<acceptance-frontend-host>
OFFERLAB_ADMIN_LOCAL_OPEN_ENABLED=false
OFFERLAB_ADMIN_UIDS=

OFFERLAB_KAFKA_ENABLED=false
KAFKA_BROKERS=

ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_URL=

OFFERLAB_REDIS_PUBSUB_ENABLED=false
OFFERLAB_REALTIME_WEBSOCKET_ENABLED=false
OFFERLAB_LOG_LEVEL=INFO
